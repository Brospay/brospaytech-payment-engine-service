# Valorapays Payment Engine - Environment Template
# Copy this file to .env and fill in your actual values
# NEVER commit .env file with real secrets!

# Application Configuration
NODE_ENV=development
SERVICE_NAME=valorapays-payment-engine
PORT=5003

# Database Configuration
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USERNAME=your_db_username
DATABASE_PASSWORD=your_db_password
DATABASE_NAME=valorapays_payment_dev
DATABASE_SSL=false

PAYMENT_PAGE_BASE_URL=http://localhost:5173

# Security Secrets (MUST be 32+ characters - Generate secure random strings!)
# Use: openssl rand -base64 32
API_KEY_ENCRYPTION_SECRET=your_api_key_encryption_secret_min_32_chars
SALT_ENCRYPTION_SECRET=your_salt_encryption_secret_min_32_chars
INTERNAL_SERVICE_SECRET=your_internal_service_secret_min_32_chars
JWT_SECRET=your_jwt_secret_min_32_chars
JWT_REFRESH_SECRET=your_jwt_refresh_secret_min_32_chars

WEBHOOK_BASE_URL=https://your-webhook-url.com

# JWT Configuration
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password_if_any
REDIS_TLS=false
REDIS_DB=3
REDIS_KEY_PREFIX=valorapays:payment:dev

# gRPC Configuration
GRPC_HOST=localhost
GRPC_PORT=50003
GRPC_PACKAGE=paymentengine
GRPC_PROTO_PATH=./src/proto/payment-engine.proto

# External Service URLs
MERCHANT_SERVICE_GRPC_URL=localhost:50002
WALLET_SERVICE_GRPC_URL=localhost:50004

# Rate Limiting Configuration
RATE_LIMIT_DEV_MAX_REQUESTS=999999
RATE_LIMIT_TEST_WINDOW_MS=60000

# Payment Processing Configuration
PAYMENT_TIMEOUT_MS=30000
MAX_RETRY_ATTEMPTS=3
RETRY_DELAY_MS=1000

# Smart Routing Configuration
ROUTING_CACHE_TTL=300
ROUTING_PERFORMANCE_WINDOW=3600
ROUTING_MIN_SUCCESS_RATE=0.95

# Fraud Detection Configuration
FRAUD_ANALYSIS_TIMEOUT=5000
FRAUD_SCORE_THRESHOLD=0.7
VELOCITY_CHECK_ENABLED=true
DEVICE_FINGERPRINT_ENABLED=true

# Webhook Configuration
WEBHOOK_RETRY_ATTEMPTS=5
WEBHOOK_RETRY_DELAY=2000
WEBHOOK_TIMEOUT=10000

# Logging Configuration
LOG_LEVEL=debug
LOG_FILE_PATH=./logs/payment-engine.log
LOG_MAX_SIZE=10m
LOG_MAX_FILES=5

# Development Features
ENABLE_MOCK_PAYMENTS=true
ENABLE_TEST_WEBHOOKS=true
ENABLE_DEBUG_LOGGING=true
ENABLE_SWAGGER_DOCS=true

# Performance Monitoring
PERFORMANCE_MONITORING_ENABLED=true
METRICS_COLLECTION_INTERVAL=60
HEALTH_CHECK_ENABLED=true

# Cache Configuration
CACHE_TTL_SECONDS=300
CONNECTION_POOL_SIZE=10

# Audit Configuration
AUDIT_ENABLED=true
AUDIT_RETENTION_DAYS=30
AUDIT_LOG_LEVEL=debug
COMMUNICATION_SERVICE_GRPC_URL=localhost:50006
